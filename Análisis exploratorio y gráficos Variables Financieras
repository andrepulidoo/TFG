import pandas as pd
import numpy as np
import os
from statsmodels.tsa.stattools import adfuller, kpss
import warnings
warnings.filterwarnings('ignore')

os.chdir(r'C:/Users/andre/OneDrive/Documentos/TFG')

empresas = ['microsoft', 'meta', 'google', 'amazon']

for empresa in empresas:
    print(f"  {empresa.upper()}")
    
    df = pd.read_csv(f'dataset_{empresa}.csv', index_col='date', parse_dates=True)
    
    # Estadísticos descriptivos
    print("DESCRIPTIVOS")
    print(df.describe().round(4).to_string())
    
    # Estacionariedad
    print("ESTACIONARIEDAD")
    for col in ['adj_close', 'excess_return', 'retorno_simple', 
                'volatilidad_20']:
        serie = df[col].dropna()
        adf = adfuller(serie, autolag='AIC')
        try:
            kpss_res = kpss(serie, regression='c', nlags='auto')
            kpss_p   = f"{kpss_res[1]:.4f}"
        except:
            kpss_p  = 'n/a'
            kpss_ok = 'n/a'
        print(f"  {col}: ADF p={adf[1]:.4f}  | KPSS p={kpss_p}")
