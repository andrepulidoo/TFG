# Analisis exploratorio
import os
os.environ['KMP_DUPLICATE_LIB_OK'] = 'TRUE'
import pandas as pd
import numpy as np
import os
from statsmodels.tsa.stattools import adfuller, kpss
import warnings
warnings.filterwarnings('ignore')

os.chdir(r'C:/Users/andre/OneDrive/Documentos/TFG')

empresas = ['microsoft', 'meta', 'google', 'amazon']

for empresa in empresas:
    print(f"\n{'='*55}")
    print(f"  {empresa.upper()}")
    print(f"{'='*55}")

    vader   = pd.read_csv(f'sentimiento_{empresa}_vader_daily.csv')
    finbert = pd.read_csv(f'sentimiento_{empresa}_finbert_daily.csv')

    vader['date']   = pd.to_datetime(vader['date'])
    finbert['date'] = pd.to_datetime(finbert['date'])

    # --- 1. FORMA DEL DATASET ---
    print("\n[1] DIMENSIONES")
    print(f"  VADER   : {vader.shape[0]} días | columnas: {vader.columns.tolist()}")
    print(f"  FinBERT : {finbert.shape[0]} días | columnas: {finbert.columns.tolist()}")

    # --- 2. RANGO TEMPORAL ---
    print("\n[2] RANGO TEMPORAL")
    print(f"  VADER   : {vader['date'].min().date()} → {vader['date'].max().date()}")
    print(f"  FinBERT : {finbert['date'].min().date()} → {finbert['date'].max().date()}")

    # --- 3. ESTADÍSTICOS DESCRIPTIVOS ---
    print("\n[3] ESTADÍSTICOS DESCRIPTIVOS - vader_mean")
    print(vader['vader_mean'].describe().round(4).to_string())

    print("\n[3] ESTADÍSTICOS DESCRIPTIVOS - finbert_mean")
    print(finbert['finbert_mean'].describe().round(4).to_string())

    # --- 4. DISTRIBUCIÓN DE ETIQUETAS ---
    print("\n[4] DISTRIBUCIÓN DE ETIQUETAS VADER (total noticias)")
    total = vader['vader_positive'].sum() + vader['vader_negative'].sum() + vader['vader_neutral'].sum()
    print(f"  Positivas : {vader['vader_positive'].sum():>6}  ({vader['vader_positive'].sum()/total*100:.1f}%)")
    print(f"  Negativas : {vader['vader_negative'].sum():>6}  ({vader['vader_negative'].sum()/total*100:.1f}%)")
    print(f"  Neutras   : {vader['vader_neutral'].sum():>6}  ({vader['vader_neutral'].sum()/total*100:.1f}%)")

    print("\n[4] DISTRIBUCIÓN DE ETIQUETAS FinBERT (total noticias)")
    total_f = finbert['finbert_positive'].sum() + finbert['finbert_negative'].sum() + finbert['finbert_neutral'].sum()
    print(f"  Positivas : {finbert['finbert_positive'].sum():>6}  ({finbert['finbert_positive'].sum()/total_f*100:.1f}%)")
    print(f"  Negativas : {finbert['finbert_negative'].sum():>6}  ({finbert['finbert_negative'].sum()/total_f*100:.1f}%)")
    print(f"  Neutras   : {finbert['finbert_neutral'].sum():>6}  ({finbert['finbert_neutral'].sum()/total_f*100:.1f}%)")

    # --- 5. NULOS EN SCORE DIARIO ---
    print("\n[5] VALORES NULOS")
    print(f"  VADER vader_mean nulos    : {vader['vader_mean'].isnull().sum()}")
    print(f"  FinBERT finbert_mean nulos: {finbert['finbert_mean'].isnull().sum()}")

    # --- 6. NOTICIAS POR DÍA ---
    print("\n[6] NOTICIAS POR DÍA")
    print(f"  VADER   - Media: {vader['n_noticias'].mean():.2f} | Máx: {vader['n_noticias'].max()} | Mín: {vader['n_noticias'].min()}")
    print(f"  FinBERT - Media: {finbert['n_noticias'].mean():.2f} | Máx: {finbert['n_noticias'].max()} | Mín: {finbert['n_noticias'].min()}")

    # --- 7. TEST DE ESTACIONARIEDAD ---
    print("\n[7] TEST ESTACIONARIEDAD - VADER")
    serie_v = vader['vader_mean'].dropna()
    adf_v = adfuller(serie_v, autolag='AIC')
    print(f"  ADF  stat={adf_v[0]:.4f}  p-value={adf_v[1]:.4f}  {'ESTACIONARIA ✓' if adf_v[1] < 0.05 else 'NO estacionaria ✗'}")
    try:
        kpss_v = kpss(serie_v, regression='c', nlags='auto')
        print(f"  KPSS stat={kpss_v[0]:.4f}  p-value={kpss_v[1]:.4f}  {'ESTACIONARIA ✓' if kpss_v[1] > 0.05 else 'NO estacionaria ✗'}")
    except:
        print("  KPSS: no calculable")

    print("\n[7] TEST ESTACIONARIEDAD - FinBERT")
    serie_f = finbert['finbert_mean'].dropna()
    adf_f = adfuller(serie_f, autolag='AIC')
    print(f"  ADF  stat={adf_f[0]:.4f}  p-value={adf_f[1]:.4f}  {'ESTACIONARIA ✓' if adf_f[1] < 0.05 else 'NO estacionaria ✗'}")
    try:
        kpss_f = kpss(serie_f, regression='c', nlags='auto')
        print(f"  KPSS stat={kpss_f[0]:.4f}  p-value={kpss_f[1]:.4f}  {'ESTACIONARIA ✓' if kpss_f[1] > 0.05 else 'NO estacionaria ✗'}")
    except:
        print("  KPSS: no calculable")

print("\n\n¡Análisis exploratorio completado!")
