
import pandas as pd
import os
import re

os.chdir(r'C:/Users/andre/OneDrive/Documentos/TFG')

# Palabras clave que indican que la noticia NO es sobre la empresa financiera
FILTROS_IRRELEVANTES = {
    'amazon':    ['amazon river', 'amazon rainforest', 'amazon forest', 'amazon jungle',
                  'amazon tribe', 'amazon women', 'amazon warriors', 'deforestation',
                  'amazon basin', 'amazon fires', 'amazon region'],
    'google':    ['google doodle', 'googled', 'google maps directions'],
    'microsoft': [],
    'meta':      ['meta analysis', 'meta-analysis', 'meta study', 'metadata']
}

empresas = ['microsoft', 'meta', 'google', 'amazon']

for empresa in empresas:
    print(f"\n{'='*50}")
    print(f"Procesando: {empresa.upper()}")
    print(f"{'='*50}")

    df = pd.read_csv(f'noticias_{empresa}.csv', on_bad_lines='skip', encoding='utf-8')
    n_original = len(df)
    print(f"  Registros originales:         {n_original:>7}")

    # 1 — Quedarse solo con columnas útiles
    df = df[[col for col in df.columns if col in ['title', 'published', 'source', 'url']]]

    # 2 — Eliminar nulos en título y fecha
    df = df.dropna(subset=['title', 'published'])
    print(f"  Tras eliminar nulos:          {len(df):>7}  (-{n_original - len(df)})")

    # 3 — Convertir fecha y filtrar rango 2020-2025
    n = len(df)
    df['published'] = pd.to_datetime(df['published'], errors='coerce')
    df = df.dropna(subset=['published'])
    df = df[(df['published'].dt.year >= 2020) & (df['published'].dt.year <= 2025)]
    print(f"  Tras filtrar fechas válidas:  {len(df):>7}  (-{n - len(df)})")

    # 4 — Separar titular de la fuente (formato "Titular - Fuente")
    def separar_titular(texto):
        # Busca el último " - " y separa
        partes = str(texto).rsplit(' - ', 1)
        if len(partes) == 2:
            return partes[0].strip()
        return str(texto).strip()

    df['title_clean'] = df['title'].apply(separar_titular)

    # 5 — Limpiar caracteres extraños del titular
    df['title_clean'] = df['title_clean'].apply(lambda x:
        re.sub(r'<[^>]+>', '', x)       # eliminar HTML residual
    )
    df['title_clean'] = df['title_clean'].apply(lambda x:
        re.sub(r'\s+', ' ', x).strip()  # espacios múltiples
    )

   
    # 6 — Eliminar noticias irrelevantes por palabras clave
    n = len(df)
    filtros = FILTROS_IRRELEVANTES.get(empresa, [])
    if filtros:
        patron = '|'.join(filtros)
        mask = df['title_clean'].str.lower().str.contains(patron, na=False)
        df = df[~mask]
    print(f"  Tras filtrar irrelevantes:    {len(df):>7}  (-{n - len(df)})")

    # 7 — Eliminar duplicados exactos por título limpio
    n = len(df)
    df = df.drop_duplicates(subset=['title_clean'])
    print(f"  Tras deduplicar (exactos):    {len(df):>7}  (-{n - len(df)})")

    # 8 — Eliminar duplicados aproximados (mismo título, distinta fecha)
    # Normalizar: minúsculas y sin puntuación para comparar
    n = len(df)
    df['title_norm'] = df['title_clean'].apply(lambda x:
        re.sub(r'[^a-z0-9\s]', '', str(x).lower()).strip()
    )
    df = df.drop_duplicates(subset=['title_norm'])
    df = df.drop(columns=['title_norm'])
    print(f"  Tras deduplicar (aprox):      {len(df):>7}  (-{n - len(df)})")

    # 9 — Ordenar por fecha
    df = df.sort_values('published').reset_index(drop=True)

    # Resumen final
    print(f"\n  TOTAL FINAL: {len(df)} noticias ({round(len(df)/n_original*100, 1)}% del original)")

    # Guardar
    df[['title_clean', 'published', 'source', 'url']].rename(
        columns={'title_clean': 'title'}
    ).to_csv(f'noticias_{empresa}_clean.csv', index=False, quoting=1)

